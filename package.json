{
  "name": "deployready",
  "version": "0.1.2",
  "description": "Local-first, AI-optional production-readiness scanner for your app. Finds security, performance, and architecture issues before you deploy.",
  "license": "MIT",
  "author": "Belal · Belsoft Solutions",
  "homepage": "https://deployready.dev",
  "type": "commonjs",
  "bin": {
    "deployready": "./bin/deployready.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin/",
    "dist/",
    "docs/sample-config.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
