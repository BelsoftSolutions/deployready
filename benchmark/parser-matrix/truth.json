{
  "_doc": "Ground truth per fixture: the URLs a real client could hit. Route strings are 'METHOD /path' with an optional trailing ' guarded' when the route truly requires authentication. ANY = every method.",
  "stacks": {
    "nextjs": [
      "GET /admin guarded",
      "GET /api/health",
      "GET /api/users",
      "POST /api/users guarded",
      "GET /api/users/[id]",
      "GET /api/admin/stats guarded"
    ],
    "express": [
      "GET /",
      "GET /api/users",
      "POST /api/users guarded",
      "GET /api/users/:id",
      "DELETE /api/users/:id guarded",
      "GET /admin/stats guarded"
    ],
    "fastify": [
      "GET /health",
      "GET /api/users",
      "GET /api/users/:id",
      "POST /api/users guarded",
      "GET /admin/stats guarded",
      "DELETE /admin/users/:id guarded"
    ],
    "nestjs": [
      "GET /health",
      "GET /users",
      "GET /users/:id",
      "POST /users guarded",
      "GET /admin/stats guarded",
      "DELETE /admin/users/:id guarded"
    ],
    "koa": [
      "GET /",
      "GET /health",
      "GET /api/users",
      "GET /api/users/:id",
      "POST /api/users guarded",
      "GET /admin/stats guarded"
    ],
    "fastapi": [
      "GET /health",
      "GET /api/users",
      "GET /api/users/{user_id}",
      "POST /api/users guarded",
      "GET /admin/stats guarded",
      "DELETE /admin/users/{user_id} guarded"
    ],
    "flask": [
      "GET /",
      "GET /api/users",
      "GET /api/users/<int:user_id>",
      "POST /api/users guarded",
      "GET /admin/stats guarded",
      "DELETE /admin/users/<int:user_id> guarded"
    ],
    "django": [
      "ANY /admin guarded",
      "ANY /health",
      "ANY /api/users",
      "ANY /api/users/<int:pk> guarded",
      "ANY /api/users/me guarded"
    ],
    "laravel": [
      "GET /",
      "GET /api/users",
      "GET /api/users/{id}",
      "POST /api/users guarded",
      "GET /api/admin/stats guarded",
      "DELETE /api/admin/users/{id} guarded"
    ],
    "unknown": [
      "GET /",
      "GET /health",
      "GET /api/users",
      "POST /api/users guarded",
      "GET /admin/stats guarded",
      "DELETE /admin/users/:id guarded"
    ]
