    "openapi-json": { "stack": "unknown", "style": "openapi.json on disk (OpenAPI 3, per-operation security)", "routes": ["GET /ping", "POST /pets", "GET /pets/{petId}", "GET /admin/stats guarded"] },
    "openapi-yaml": { "stack": "unknown", "style": "openapi.yaml on disk (relative server /api, global security, security: [] override)", "routes": ["GET /api/ping", "GET /api/pets/{petId} guarded", "GET /api/admin/stats guarded"] },
    "openapi-swagger2-basepath": { "stack": "unknown", "style": "swagger.yaml on disk (Swagger 2 basePath /v1)", "routes": ["GET /v1/ping"] },
    "js-hono-route-mount": { "stack": "unknown", "style": "Hono app.route('/api', sub) with sub imported from another file", "routes": ["GET /api/items"] },
    "js-hono-basepath-same-file": { "stack": "unknown", "style": "Hono same-file nesting: app.route + sub.route + new Hono().basePath('/v1')", "routes": ["GET /api/v1/reports/daily"] },
    "js-fastify-nested-prefix": { "stack": "fastify", "style": "nested fastify.register(plugin, { prefix }) across two files", "routes": ["GET /v1/items"] },
    "js-fastify-inline-plugin-prefix": { "stack": "fastify", "style": "fastify.register(async function (app) { app.get(...) }, { prefix })", "routes": ["GET /api/items"] },
