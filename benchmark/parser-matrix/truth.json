    "js-express-mount-template-prefix": { "stack": "express", "style": "app.use(`/api/${VERSION}`, router) with a same-file const", "routes": ["GET /api/v1/items"] },
    "py-fastapi-nested-router-prefix": { "stack": "fastapi", "style": "APIRouter(prefix) + router.include_router(child) + app.include_router(prefix) across files", "routes": ["GET /api/v1/items"] },
    "py-flask-nested-blueprint-prefix": { "stack": "flask", "style": "api.register_blueprint(items, url_prefix) then app.register_blueprint(api), same file", "routes": ["GET /api/items"] },
