rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Looks like an owner-ish check to a reader, but `resource == null` lets anyone create,
      // and the second branch lets any signed-in user touch every user's document.
      allow read, write: if resource == null || request.auth != null;
    }
  }
}
